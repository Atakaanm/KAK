<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kaç Ata Kaç — uygulama gizlilik bildirimi (Apple).
  Oyun izleme yapmaz ve veri toplamaz. Kayıt cihazda: PlayerPrefs (NSUserDefaults) → gerekçe CA92.1 (yalnızca uygulamanın kendi verisi).
  Reklam SDK'sı eklenince SDK kendi bildirimini getirir; toplanan veri türleri (cihaz kimliği, reklam verisi) burada ve
  App Store Connect gizlilik etiketlerinde güncellenmelidir (Docs/Reklam-Hazirlik.md).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
